Package: FCtools
Title: Functional Connectivity Tools
Version: 2.3.1
Date: 2026-09-08
Authors@R: c(
    person("Junhong", "Yu", , "junhong.yu@ntu.edu.sg", role = "aut",
           comment = c(ORCID = "0000-0002-2563-9658")),
    person("Charly", "Billaud", , "charly.billaud@ntu.edu.sg", role = c("aut","cre"),
